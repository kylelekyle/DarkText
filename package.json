{
  "name": "darktext",
  "version": "0.1.3",
  "description": "A minimalist, portable word processor for long-form authors",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "npm run test:unit && npm run test:rust && npm run test:docx",
    "test:ci": "npm run lint && npm run check && npm run test:unit && npm run test:rust && npm run clippy && npm run build && npm run test:docx && npm run test:integration",
    "test:integration": "cargo test --manifest-path src-tauri/Cargo.toml --test workflow && cargo test --manifest-path src-tauri/Cargo.toml library_workflow_roundtrip && cargo test --manifest-path src-tauri/Cargo.toml strip_review_marks_removes_spans && cargo test --manifest-path src-tauri/Cargo.toml sanitize_filename_collapses_underscores && cargo test --manifest-path src-tauri/Cargo.toml search_index_finds_saved_chapter",
    "lint": "oxlint src",
    "test:unit": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "test:docx": "node scripts/test-docx-export.mjs",
    "tauri": "tauri",
    "tauri:build:clean": "node scripts/clean-target.mjs --build",
    "clean:target": "node scripts/clean-target.mjs",
    "generate:test-library": "node scripts/generate-test-library.mjs",
    "generate:test-library:2x": "node scripts/generate-test-library.mjs --double",
    "generate:test-library:4x": "node scripts/generate-test-library.mjs --scale=4"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tiptap/core": "^3.27.1",
    "@tiptap/extension-font-family": "^3.27.1",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-table": "^3.27.1",
    "@tiptap/extension-table-cell": "^3.27.1",
    "@tiptap/extension-table-header": "^3.27.1",
    "@tiptap/extension-table-row": "^3.27.1",
    "@tiptap/extension-text-align": "^3.27.1",
    "@tiptap/extension-text-style": "^3.27.1",
    "@tiptap/extension-underline": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "docx": "^9.7.1",
    "jszip": "^3.10.1",
    "typo-js": "^1.3.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "happy-dom": "^17.6.3",
    "oxlint": "^1.71.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^3.2.6"
  }
}
